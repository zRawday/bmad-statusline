# Force LF in the working tree for all text files. `npm publish` packs the
# working-tree bytes, so a CRLF checkout on Windows would ship a CRLF shebang in
# bin/cli.js — which breaks `npx bmad-statusline` on every macOS/Linux machine
# ("env: 'node\r': No such file or directory").
* text=auto eol=lf
